# External repositories, cloned by scripts/setup.sh (large: ~37 GB)
external/*/
!external/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.venv-*/
venv/
.pytest_cache/
*.egg-info/

# Environment / secrets: the API key must never end up in a commit
.env
.env.*
!.env.example
*.key
*.pem
id_rsa*

# Run output (runs/ is ~555 MB; the three files already versioned stay)
runs/
*.log
.DS_Store
**/.DS_Store

# Lean build artifacts
.lake/
build/

# Third-party data with no declared licence (A. E. Brouwer's tables):
# they stay on disk, search/reproduce.py downloads them again
research_data/codes/
research_data/Andw.html
research_data/binary-1.html

# Internal working notes, not published
interno/
internal/

# Local tool configuration
.claude/

# Generated indices: rebuild them with `python verifier/index.py --build`
verifier/problem_index.json
verifier/problem_index_main.json
