# Repository esterni clonati (grandi, gestiti da scripts/setup.sh): ~37 GB
external/*/
!external/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.venv-*/
venv/
.pytest_cache/
*.egg-info/

# Ambiente / segreti: la chiave API non deve mai finire in un commit
.env
.env.*
!.env.esempio
*.key
*.pem
id_rsa*

# Output temporanei (runs/ sono ~555 MB; i tre file gia' versionati restano)
runs/
*.log
.DS_Store
**/.DS_Store

# Lean build artifacts
.lake/
build/
