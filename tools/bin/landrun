#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# A landrun SHIM for macOS.
#
# `landrun` (https://github.com/Zouuup/landrun) uses Landlock, a Linux kernel
# feature that does NOT exist on macOS. comparator calls it to sandbox the
# compilation of the candidate file.
#
# This shim accepts and IGNORES every landrun option and runs the command
# without a sandbox. It is the same strategy as `scripts/fake-landrun.sh`, the
# script comparator itself ships for development on non-Linux systems.
#
# SECURITY CONSEQUENCE: on macOS we lose the isolation of the compilation
# process. comparator's logical guarantees (same statement, permitted axioms,
# accepted by the kernel) still hold; what is lost is the protection against a
# candidate file that runs arbitrary code while it compiles. That is why
# verify.py adds a syntactic pre-scan of its own (see verifier/verify.py), and
# why it wraps the compilation in `sandbox-exec` (see verifier/sandbox.py).
# ---------------------------------------------------------------------------
set -euo pipefail

flags_with_value=( --ro --rox --rw --rwx --bind-tcp --connect-tcp --log-level --env )

is_value_flag() {
  local f="$1"
  for vf in "${flags_with_value[@]}"; do
    [[ "$f" == "$vf" ]] && return 0
  done
  return 1
}

case "${1:-}" in
  -h|--help)   echo "landrun shim (macOS): accepts and ignores the flags, runs the command"; exit 0 ;;
  -V|--version) echo "NON-SANDBOXING SHIM (macOS)" >&2; exit 0 ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift; break ;;
    -*) is_value_flag "$1" && shift; shift ;;
    *) break ;;
  esac
done

if [[ $# -eq 0 ]]; then
  echo "landrun shim: no command given" >&2
  exit 2
fi

exec "$@"
