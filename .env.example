# Copy this file to `.env` and put your real key in it:
#
#   cp .env.example .env
#
# Create a key at https://console.anthropic.com/settings/keys
# `.env` is excluded by .gitignore, so the key can never end up in a commit.
# Only the agent needs it; the verifier and the searches run without any key.

ANTHROPIC_API_KEY=sk-ant-put-your-key-here
