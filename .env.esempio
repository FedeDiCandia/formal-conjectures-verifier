# Copia questo file in `.env` e metti la tua chiave vera.
#   cp .env.esempio .env
# Poi apri `.env` e sostituisci la riga qui sotto.
#
# La chiave si crea su https://console.anthropic.com/settings/keys
# Il file `.env` e' escluso da git: la chiave non finira' mai in un commit.

ANTHROPIC_API_KEY=sk-ant-metti-qui-la-tua-chiave
